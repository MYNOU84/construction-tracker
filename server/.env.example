# ─── Database ────────────────────────────────────────────────────────────────
# Local development: SQLite file (default)
#   DATABASE_URL="file:./dev.db"
# Hosted (Vercel + Neon Free): the Neon *pooled* connection string, e.g.
#   postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/buildtrack_demo?sslmode=require&pgbouncer=true&connection_limit=1&connect_timeout=15
# One-time schema + demo seed uses the Neon *direct* (non-pooler) string:
#   DEMO_DATABASE_URL="<direct URL>" npm run db:prod-init   (see docs/WP7-DEPLOYMENT.md)
DATABASE_URL="file:./dev.db"

# ─── Authentication ───────────────────────────────────────────────────────────
# Required in production, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse a secret that has ever been committed to Git.
# Production needs its OWN secret, set in the hosting provider's environment
# variables (never this file, never the local development value).
JWT_SECRET="change-me-use-a-long-random-secret"
# Session lifetime (sessions are stored in an httpOnly cookie)
JWT_EXPIRES_IN="12h"

# Self-registration is open in development and closed in production unless enabled here.
# ALLOW_REGISTRATION=false

# ─── Public demo ──────────────────────────────────────────────────────────────
# DEMO_MODE=true makes the whole API read-only, disables password sign-in
# and offers one-click access to the accounts listed in DEMO_USER_EMAILS.
# Only point a demo deployment at a dedicated demonstration database.
# DEMO_MODE=false
# DEMO_USER_EMAILS="viewer@demo.example,engineer@demo.example"   (never list an ADMIN account)
# In DEMO_MODE, "last 7 / 30 days" charts end at the latest daily-report date, so the demo stays
# populated without reseeding.
# Keep password sign-in available while DEMO_MODE is on (not recommended for a public demo)
# ALLOW_PASSWORD_LOGIN=false

# ─── Uploads ──────────────────────────────────────────────────────────────────
# Disk uploads are disabled automatically when DEMO_MODE=true or on Vercel (VERCEL is set by the
# platform): its filesystem is read-only/ephemeral and no paid storage is used.
# Folder for uploaded files (default: server/uploads)
# UPLOAD_DIR=./uploads

# ─── Local database guard ─────────────────────────────────────────────────────
# DB_UPGRADE=true lets `npm start` apply pending schema changes to an existing
# SQLite database (after a backup). Prefer running `npm run db:upgrade` once.
# DB_UPGRADE=false

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Production only: comma-separated list of allowed browser origins.
# Leave unset when the client and API are served from the same origin.
# CORS_ORIGIN=https://your-app.example.com
