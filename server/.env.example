# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL (Railway auto-injects this when you add a PostgreSQL plugin)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-me-use-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Leave empty to allow all origins, or set your frontend URL
# CORS_ORIGIN=https://your-app.railway.app

# ─── File Uploads ─────────────────────────────────────────────────────────────
MAX_FILE_SIZE=52428800
