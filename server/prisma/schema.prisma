generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("SITE_ENGINEER")
  avatar    String?
  phone     String?
  company   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectMembers ProjectMember[]
  dailyReports   DailyReport[]
  comments       Comment[]
  documents      Document[]
}

model Project {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  client      String
  consultant  String?
  contractor  String?
  location    String
  startDate   DateTime
  endDate     DateTime
  status      String   @default("ACTIVE")
  progress    Float    @default(0)
  budget      Float?
  actualCost  Float?
  currency    String   @default("USD")
  imageUrl         String?
  presentationData String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  members        ProjectMember[]
  dailyReports   DailyReport[]
  weeklyReports  WeeklyReport[]
  monthlyReports MonthlyReport[]
  milestones     Milestone[]
  activities     Activity[]
  documents      Document[]
  risks          Risk[]
  ncrs           NCR[]
  plantEquipment PlantEquipment[]
  siteResources  SiteResource[]
}

model ProjectMember {
  id        String  @id @default(cuid())
  userId    String
  projectId String
  role      String  @default("MEMBER")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model DailyReport {
  id           String   @id @default(cuid())
  projectId    String
  reportDate   DateTime
  reportNumber Int
  weekNumber   Int      @default(0)

  weather     String   @default("Clear")
  temperature Float?
  humidity    Float?
  windSpeed   Float?
  conditions  String?

  generalSummary String?
  workCompleted  String?
  plannedWork    String?

  manpowerData   String @default("[]")
  totalManpower  Int    @default(0)
  equipmentData  String @default("[]")
  materialsData  String @default("[]")
  activitiesData String @default("[]")
  delays         String @default("[]")
  issues         String @default("[]")
  risks          String @default("[]")
  pendingActions String @default("[]")
  inspections    String @default("[]")

  hseData       String  @default("{}")
  safetyNotes   String?
  incidents     Int     @default(0)
  nearMisses    Int     @default(0)
  toolboxTalks  Int     @default(0)

  status      String   @default("DRAFT")
  submittedBy String
  submittedAt DateTime?
  approvedBy  String?
  approvedAt  DateTime?

  photos   Photo[]
  comments Comment[]

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [submittedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WeeklyReport {
  id        String   @id @default(cuid())
  projectId String
  weekNumber Int
  year      Int
  startDate DateTime
  endDate   DateTime

  executiveSummary   String?
  highlightsAchieved String?
  issuesEncountered  String?
  nextWeekPlan       String?

  overallProgress      Float  @default(0)
  plannedProgress      Float  @default(0)
  progressByDiscipline String @default("{}")

  manpowerByDay    String @default("{}")
  totalManpowerWeek Int   @default(0)
  peakManpower     Int   @default(0)

  activitiesCompleted Int @default(0)
  activitiesDelayed   Int @default(0)
  activitiesOngoing   Int @default(0)

  spi Float?
  cpi Float?

  weatherSummary    String?
  lotsData          String @default("[]")
  manpowerBreakdown String @default("{}")
  studiesProgress   String @default("[]")
  materialApprovals String @default("[]")

  status String @default("DRAFT")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, weekNumber, year])
}

model MonthlyReport {
  id        String @id @default(cuid())
  projectId String
  month     Int
  year      Int

  executiveSummary String?
  keyAchievements  String?
  majorChallenges  String?
  nextMonthPlan    String?

  overallProgress Float @default(0)
  plannedProgress Float @default(0)

  architectureProgress   Float @default(0)
  structureProgress      Float @default(0)
  mecaniqueProgress      Float @default(0)
  electriciteProgress    Float @default(0)
  plomberieProgress      Float @default(0)
  infrastructureProgress Float @default(0)

  totalManpowerDays Int   @default(0)
  peakManpower      Int   @default(0)
  avgDailyManpower  Float @default(0)

  budgetExpended   Float?
  forecastFinalCost Float?
  variance         Float?

  completedMilestones Int @default(0)
  pendingMilestones   Int @default(0)
  delayedMilestones   Int @default(0)

  openRisks      Int @default(0)
  mitigatedRisks Int @default(0)
  openNCRs       Int @default(0)
  closedNCRs     Int @default(0)

  kpis                 String @default("{}")
  photos               String @default("[]")
  progressByDiscipline String @default("{}")
  studiesProgress      String @default("[]")
  materialApprovals    String @default("[]")

  status String @default("DRAFT")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, month, year])
}

model Activity {
  id          String  @id @default(cuid())
  projectId   String
  name        String
  description String?
  discipline  String  @default("GENERAL")
  area        String?
  phase       String?
  wbsCode     String?

  plannedStart DateTime
  plannedEnd   DateTime
  actualStart  DateTime?
  actualEnd    DateTime?

  plannedProgress Float @default(0)
  actualProgress  Float @default(0)

  status   String @default("NOT_STARTED")
  priority String @default("MEDIUM")

  dependencies String @default("[]")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Milestone {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  plannedDate DateTime
  actualDate  DateTime?
  status      String   @default("PENDING")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id          String  @id @default(cuid())
  projectId   String
  name        String
  description String?
  type        String  @default("OTHER")
  fileUrl     String
  fileName    String
  fileSize    Int?
  mimeType    String?
  revision    String?
  tags        String  @default("[]")
  uploadedBy  String

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader  User     @relation(fields: [uploadedBy], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Risk {
  id          String  @id @default(cuid())
  projectId   String
  title       String
  description String
  category    String  @default("GENERAL")
  probability Int     @default(3)
  impact      Int     @default(3)
  riskScore   Int     @default(9)
  status      String  @default("OPEN")
  mitigation  String?
  owner       String?
  dueDate     DateTime?

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NCR {
  id        String @id @default(cuid())
  projectId String
  ncrNumber String

  title       String
  description String
  area        String?
  discipline  String?
  severity    String @default("MEDIUM")

  raisedBy   String
  raisedDate DateTime

  status     String    @default("OPEN")
  resolution String?
  closedDate DateTime?

  photos Photo[]

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlantEquipment {
  id           String    @id @default(cuid())
  projectId    String
  name         String
  category     String    @default("GENERAL")
  make         String?
  model        String?
  serialNumber String?
  plateNumber  String?
  owner        String?
  hireCompany  String?
  dateOnSite   DateTime
  dateOffSite  DateTime?
  status       String    @default("ON_SITE")
  certExpiry   DateTime?
  lastInspection DateTime?
  hoursOnSite  Float     @default(0)
  notes        String?

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteResource {
  id            String    @id @default(cuid())
  projectId     String
  fullName      String
  company       String?
  trade         String?
  position      String?
  type          String    @default("DIRECT")
  idNumber      String?
  inductionDate DateTime?
  status        String    @default("ACTIVE")
  notes         String?

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Photo {
  id        String  @id @default(cuid())
  url       String
  fileName  String
  caption   String?
  takenAt   DateTime?
  location  String?
  fileSize  Int?

  dailyReportId String?
  ncrId         String?

  dailyReport DailyReport? @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  ncr         NCR?         @relation(fields: [ncrId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Comment {
  id      String @id @default(cuid())
  content String
  userId  String

  dailyReportId String?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyReport DailyReport? @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
