{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "cd server && node scripts/set-provider.js && npx prisma generate && cd .. && npm --prefix client run build",
  "outputDirectory": "client/dist",
  "regions": ["fra1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "server/node_modules/.prisma/client/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/uploads/(.*)", "destination": "/api" },
    { "source": "/((?!api/|uploads/|assets/|demo-docs/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/demo-docs/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
